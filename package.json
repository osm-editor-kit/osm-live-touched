{
  "name": "osm-live-touched",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @osm-editor-kit/live-touched build",
    "check": "bun run --filter '*' check",
    "check-exports": "bun run --filter @osm-editor-kit/live-touched check-exports",
    "format": "bun run --filter '*' format",
    "format-check": "bun run --filter '*' format-check",
    "josm-build": "bun run --filter live-touched-josm-plugin josm-build",
    "josm-install": "bun run --filter live-touched-josm-plugin josm-install",
    "lint": "bun run --filter '*' lint",
    "lint-check": "bun run --filter '*' lint-check",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "test-run": "bun run --filter '*' test-run",
    "type-check": "bun run --filter '*' type-check",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "bun@1.4.4"
}
